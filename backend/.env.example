PORT=3001
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.5-flash-lite

# Admin panel token - REQUIRED to enable /admin and /api/admin/*.
# Generate one: node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
ADMIN_TOKEN=YOUR_ADMIN_TOKEN_HERE

# Optional overrides
# RATE_LIMIT_GLOBAL=10   (per-IP requests per minute; default 10)
# RATE_LIMIT_AI=10       (per-IP AI requests per minute; default 10)
# ADMIN_AUTH_MAX=10      (wrong admin token attempts allowed per 10 min; default 10)
# DATA_DIR=./data        (database directory override)
